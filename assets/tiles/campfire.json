{
  "id": "campfire",
  "name": "Campfire",
  "handler": "campfire",
  "sprite_sheet": "tiles/campfire.png",

  "states": {
    "default": "not_lit",
    "values": [
      { "id": "not_lit",  "frame": 0 },
      { "id": "lit",      "frame": 1, "light_radius": 6, "light_color": [255, 180, 80] },
      { "id": "cooking",  "frame": 2, "light_radius": 6, "light_color": [255, 180, 80] }
    ]
  },

  "properties": {
